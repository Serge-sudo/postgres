--- Test RIGHT JOIN
+-- Test nested outer joins
+\echo 'Testing nested LEFT JOINs:'
+Testing nested LEFT JOINs:
 SET enable_outer_join_limit_pushdown = on;
-EXPLAIN (COSTS OFF) 
+EXPLAIN (COSTS OFF, VERBOSE)
+SELECT t1.id, t1.name, t2.category, t3.description 
+FROM oj_t1 t1 
+LEFT JOIN oj_t2 t2 ON t1.id = t2.id 
+LEFT JOIN oj_t3 t3 ON t1.id = t3.id 
+ORDER BY t1.id LIMIT 4;
+                         QUERY PLAN                          
+-------------------------------------------------------------
+ Limit
+   Output: t1.id, t1.name, t2.category, t3.description
+   ->  Nested Loop Left Join
+         Output: t1.id, t1.name, t2.category, t3.description
+         Join Filter: (t1.id = t3.id)
+         ->  Merge Left Join
+               Output: t1.id, t1.name, t2.category
+               Merge Cond: (t1.id = t2.id)
+               ->  Sort
+                     Output: t1.id, t1.name
+                     Sort Key: t1.id
+                     ->  Seq Scan on public.oj_t1 t1
+                           Output: t1.id, t1.name
+               ->  Sort
+                     Output: t2.category, t2.id
+                     Sort Key: t2.id
+                     ->  Seq Scan on public.oj_t2 t2
+                           Output: t2.category, t2.id
+         ->  Materialize
+               Output: t3.description, t3.id
+               ->  Seq Scan on public.oj_t3 t3
+                     Output: t3.description, t3.id
+(22 rows)
+
+-- Test RIGHT JOIN  
+\echo 'Testing RIGHT JOIN optimization:'
+Testing RIGHT JOIN optimization:
+SET enable_outer_join_limit_pushdown = on;
+EXPLAIN (COSTS OFF, VERBOSE)
 SELECT t1.id, t1.name, t2.category FROM oj_t1 t1 
 RIGHT JOIN oj_t2 t2 ON t1.id = t2.id 
 ORDER BY t2.id LIMIT 2;
-               QUERY PLAN               
-----------------------------------------
+                     QUERY PLAN                     
+----------------------------------------------------
  Limit
+   Output: t1.id, t1.name, t2.category, t2.id
    ->  Merge Left Join
+         Output: t1.id, t1.name, t2.category, t2.id
          Merge Cond: (t2.id = t1.id)
          ->  Sort
+               Output: t2.category, t2.id
                Sort Key: t2.id
-               ->  Seq Scan on oj_t2 t2
+               ->  Seq Scan on public.oj_t2 t2
+                     Output: t2.category, t2.id
          ->  Sort
+               Output: t1.id, t1.name
                Sort Key: t1.id
-               ->  Seq Scan on oj_t1 t1
-(9 rows)
+               ->  Seq Scan on public.oj_t1 t1
+                     Output: t1.id, t1.name
+(15 rows)
 
