-   InitPlan 1
-     ->  Result (actual rows=1 loops=1)
-   ->  Seq Scan on listp_1_1 listp_1 (never executed)
-         Filter: (a = (InitPlan 1).col1)
-   ->  Seq Scan on listp_2_1 listp_2 (never executed)
-         Filter: (a = (InitPlan 1).col1)
-(7 rows)
-
-drop table listp;
