-create or replace function exc_using(int) returns void as $$
-declare
-  c refcursor;
-  i int;
-begin
-  open c for execute 'select * from generate_series(1,$1)' using $1+1;
-  loop
-    fetch c into i;
-    exit when not found;
-    raise notice '%', i;
-  end loop;
-  close c;
-  return;
-end;
-$$ language plpgsql;
