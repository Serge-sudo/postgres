-ALTER FOREIGN TABLE ft1 ADD COLUMN c8 integer DEFAULT 0;
-ALTER FOREIGN TABLE ft1 ALTER COLUMN c8 TYPE char(10);
-SELECT count(*)
-  FROM pg_attribute
