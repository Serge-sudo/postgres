-REINDEX INDEX concur_reindex_ind;
-NOTICE:  REINDEX START: ddl_command_start REINDEX
-NOTICE:  REINDEX END: command_tag=REINDEX type=index identity=public.concur_reindex_ind
-REINDEX TABLE concur_reindex_tab;
