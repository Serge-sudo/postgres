-- ALTER DATABASE ... SET SHARD GROUP
CREATE SERVER server1
    FOREIGN DATA WRAPPER postgres_fdw
    OPTIONS (host 'localhost', dbname 'regression', port '5432');
ALTER SHARD GROUP sg_test ADD MEMBER server1;
SELECT * FROM pg_foreign_server;
  oid  | srvname | srvowner | srvfdw | srvtype | srvversion | srvacl |                  srvoptions                  
-------+---------+----------+--------+---------+------------+--------+----------------------------------------------
 16492 | server1 |       10 |  16487 |         |            |        | {host=localhost,dbname=regression,port=5432}
(1 row)

SELECT * FROM pg_shardmembers;
  oid  | sgid  | srvid | smpriority | smstate | smoptions 
-------+-------+-------+------------+---------+-----------
 16493 | 16491 | 16492 |        100 | u       | 
(1 row)

DROP SERVER server1;
ERROR:  cannot drop server server1 because other objects depend on it
DETAIL:  shard group member server1 in sg_test depends on server server1
HINT:  Use DROP ... CASCADE to drop the dependent objects too.
ALTER SHARD GROUP sg_test DROP MEMBER server1;
SELECT * FROM pg_shardmembers;
 oid | sgid | srvid | smpriority | smstate | smoptions 
-----+------+-------+------------+---------+-----------
(0 rows)

ALTER SHARD GROUP sg_test ADD MEMBER server1;
SELECT * FROM pg_foreign_server;
  oid  | srvname | srvowner | srvfdw | srvtype | srvversion | srvacl |                  srvoptions                  
-------+---------+----------+--------+---------+------------+--------+----------------------------------------------
 16492 | server1 |       10 |  16487 |         |            |        | {host=localhost,dbname=regression,port=5432}
(1 row)

-- check default shard group
CREATE WORLDWIDE TABLE test_t_worldwide (a int, b int);
NOTICE:  WORLDWIDE table not yet fully implemented
DETAIL:  Table will be created as worldwide table.
NOTICE:  table "public.test_t_worldwide" should be created on shard member "server1"
DETAIL:  Execute: CREATE TABLE IF NOT EXISTS public.test_t_worldwide (a integer, b integer)
SELECT * FROM pg_class WHERE relname like 'test_t_%';
