DROP TABLE test_t_worldwide;
--check non-default shard group
CREATE SHARD GROUP sg_test_2;
SELECT * FROM pg_shardgroups;
  oid  |  sgname   | sgowner | sgoptions 
-------+-----------+---------+-----------
