--
-- Test sharding DDL syntax
--
-- These tests verify that the basic sharding DDL parses correctly.
-- Full implementation is TODO.
--
CREATE EXTENSION IF NOT EXISTS postgres_fdw;
SELECT * FROM pg_shardgroups;
 oid | sgname | sgowner | sgoptions 
-----+--------+---------+-----------
(0 rows)

SELECT * FROM pg_shardmembers;
 oid | sgid | srvid | smpriority | smstate | smoptions 
-----+------+-------+------------+---------+-----------
(0 rows)

\d+ pg_shardgroups
                              Table "pg_catalog.pg_shardgroups"
  Column   |  Type  | Collation | Nullable | Default | Storage  | Stats target | Description 
-----------+--------+-----------+----------+---------+----------+--------------+-------------
 oid       | oid    |           | not null |         | plain    |              | 
 sgname    | name   |           | not null |         | plain    |              | 
 sgowner   | oid    |           | not null |         | plain    |              | 
 sgoptions | text[] | C         |          |         | extended |              | 
Indexes:
    "pg_shardgroups_oid_index" PRIMARY KEY, btree (oid)
    "pg_shardgroups_name_index" UNIQUE CONSTRAINT, btree (sgname)

\d+ pg_shardmembers
                              Table "pg_catalog.pg_shardmembers"
   Column   |  Type   | Collation | Nullable | Default | Storage  | Stats target | Description 
------------+---------+-----------+----------+---------+----------+--------------+-------------
 oid        | oid     |           | not null |         | plain    |              | 
 sgid       | oid     |           | not null |         | plain    |              | 
 srvid      | oid     |           | not null |         | plain    |              | 
 smpriority | integer |           | not null |         | plain    |              | 
 smstate    | "char"  |           | not null |         | plain    |              | 
 smoptions  | text[]  | C         |          |         | extended |              | 
Indexes:
    "pg_shardmembers_oid_index" PRIMARY KEY, btree (oid)
    "pg_shardmembers_sgid_srvid_index" UNIQUE CONSTRAINT, btree (sgid, srvid)

-- CREATE SHARD GROUP 
CREATE SHARD GROUP sg_test;
SELECT * FROM pg_shardgroups;
  oid  | sgname  | sgowner | sgoptions 
-------+---------+---------+-----------
 16491 | sg_test |      10 | 
(1 row)

-- -- Test error message
CREATE SHARD GROUP sg_test;
ERROR:  shard group "sg_test" already exists
SELECT * FROM pg_shardgroups;
  oid  | sgname  | sgowner | sgoptions 
-------+---------+---------+-----------
 16491 | sg_test |      10 | 
(1 row)

ALTER DATABASE regression SET DEFAULT SHARD GROUP sg_test;
